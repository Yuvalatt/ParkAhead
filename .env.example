# Copy to .env and fill in real values. .env is gitignored.

POSTGRES_DB=parkahead
POSTGRES_USER=parkahead
POSTGRES_PASSWORD=changeme

# "Mock" needs no key and is the default for local dev.
# Switch to "Ticketmaster" and supply a free API key from https://developer.ticketmaster.com/ to use real event data.
EVENT_SOURCE_PROVIDER=Mock
TICKETMASTER_API_KEY=

# Google Maps JavaScript API key with the "Places API" enabled, used by the frontend's
# address autocomplete. Get one at https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
